<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="raizPrincipal" prefHeight="800.0" prefWidth="1200.0"
            fx:controller="com.proyecto1.ui.controller.MainController" xmlns:fx=" ">
    <top>
        <VBox>
            <MenuBar fx:id="barraMenu">
                <Menu text="Archivo">
                </Menu>
                <Menu text="Editar">
                    <MenuItem text="Deshacer" onAction="#accionDeshacer"/>
                    <MenuItem text="Rehacer" onAction="#accionRehacer"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Cortar" onAction="#accionCortar"/>
                    <MenuItem text="Copiar" onAction="#accionCopiar"/>
                    <MenuItem text="Pegar" onAction="#accionPegar"/>
                    <MenuItem text="Seleccionar todo" onAction="#accionSeleccionarTodo"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Buscar / Reemplazar..." onAction="#accionBuscarReemplazar"/>
                </Menu>
                <Menu text="Ver">
                    <CheckMenuItem fx:id="miMostrarArbol" text="Mostrar arbol de trabajo" selected="true" onAction="#accionAlternarArbol"/>
                    <CheckMenuItem fx:id="miMostrarPanelInferior" text="Mostrar consola y errores" selected="true" onAction="#accionAlternarPanelInferior"/>
                </Menu>
                <Menu text="Ejecutar">
                    <MenuItem text="Analizar archivo actual" onAction="#accionAnalizarArchivoActual"/>
                    <MenuItem text="Compilar todo el proyecto" onAction="#accionCompilarProyecto"/>
                    <MenuItem text="Ejecutar ultimo analisis" onAction="#accionEjecutarUltimoAnalisis"/>
                </Menu>
                <Menu text="Ayuda">
                    <MenuItem text="Acerca de" onAction="#accionAcercaDe"/>
                    <MenuItem text="Manual de usuario" onAction="#accionManualUsuario"/>
                </Menu>
            </MenuBar>
            <ToolBar fx:id="barraHerramientas">
                <Button fx:id="btnNuevoProyecto" text="Nuevo proyecto" onAction="#accionNuevoProyecto"/>
                <Button fx:id="btnAbrirCarpeta" text="Abrir carpeta" onAction="#accionAbrirCarpeta"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="btnNuevoArchivo" text="Nuevo archivo" onAction="#accionNuevoArchivo"/>
                <Button fx:id="btnAbrirArchivo" text="Abrir archivo" onAction="#accionAbrirArchivo"/>
                <Button fx:id="btnGuardar" text="Guardar" onAction="#accionGuardar"/>
                <Button fx:id="btnGuardarComo" text="Guardar como" onAction="#accionGuardarComo"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="btnDeshacer" text="Deshacer" onAction="#accionDeshacer"/>
                <Button fx:id="btnRehacer" text="Rehacer" onAction="#accionRehacer"/>
                <Button fx:id="btnBuscar" text="Buscar" onAction="#accionBuscarReemplazar"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="btnAnalizar" text="Analizar" onAction="#accionAnalizarArchivoActual"/>
                <Button fx:id="btnEjecutar" text="Ejecutar" onAction="#accionCompilarProyecto"/>
            </ToolBar>
        </VBox>
    </top>
    <left>
        <TitledPane fx:id="panelArbol" text="Arbol de trabajo" collapsible="false" prefWidth="260.0">
            <StackPane>
                <TreeView fx:id="arbolTrabajo" showRoot="true"/>
                <VBox fx:id="panelArbolVacio" alignment="CENTER" spacing="12" styleClass="panel-arbol-vacio">
                    <Label text="Sin proyectos abiertos" styleClass="texto-suave"/>
                    <Label text="Crea uno nuevo o abre una carpeta existente" styleClass="texto-suave" wrapText="true" textAlignment="CENTER" maxWidth="180"/>
                    <Button text="Nuevo proyecto" onAction="#accionNuevoProyecto" maxWidth="160"/>
                    <Button text="Abrir carpeta" onAction="#accionAbrirCarpeta" maxWidth="160"/>
                </VBox>
            </StackPane>
        </TitledPane>
    </left>
    <center>
        <SplitPane fx:id="splitCentral" dividerPositions="0.66" orientation="VERTICAL">
            <StackPane>
                <TabPane fx:id="panelPestanas" tabClosingPolicy="ALL_TABS"/>
                <VBox fx:id="panelBienvenida" alignment="CENTER" spacing="16" styleClass="panel-bienvenida">
                    <Label text="Compilador - Proyecto 1" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                    <Label text="Abre una carpeta o crea un archivo para empezar" styleClass="texto-suave"/>
                    <HBox alignment="CENTER" spacing="10">
                        <Button text="Abrir carpeta" onAction="#accionAbrirCarpeta"/>
                        <Button text="Abrir archivo" onAction="#accionAbrirArchivo"/>
                        <Button text="Nuevo archivo" onAction="#accionNuevoArchivo"/>
                    </HBox>
                </VBox>
            </StackPane>
            <TabPane fx:id="panelInferior" tabClosingPolicy="UNAVAILABLE" styleClass="panel-inferior">
                <Tab fx:id="tabConsola" text="Consola">
                    <TextArea fx:id="consolaSalida" editable="false" wrapText="true" styleClass="consola-salida"/>
                </Tab>
                <Tab fx:id="tabErrores" text="Errores">
                    <TableView fx:id="tablaErrores" styleClass="tabla-errores">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colTipo" text="TIPO ERROR" minWidth="110.0" prefWidth="130.0" maxWidth="180.0"/>
                            <TableColumn fx:id="colFila" text="FILA" minWidth="55.0" prefWidth="65.0" maxWidth="100.0"/>
                            <TableColumn fx:id="colColumna" text="COLUMNA" minWidth="80.0" prefWidth="90.0" maxWidth="120.0"/>
                            <TableColumn fx:id="colDescripcion" text="DESCRIPCIÓN" minWidth="250.0" prefWidth="900.0"/>
                        </columns>
                        <placeholder>
                            <Label text="(Sin errores por ahora)" styleClass="texto-suave"/>
                        </placeholder>
                    </TableView>
                </Tab>
            </TabPane>
        </SplitPane>
    </center>
    <bottom>
        <HBox fx:id="barraEstado" styleClass="barra-estado" spacing="16.0">
            <padding>
                <Insets top="6.0" bottom="6.0" left="14.0" right="14.0"/>
            </padding>
            <Label fx:id="lblRutaActiva" text="Sin archivo abierto"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="lblPosicionCursor" text="Linea 1, Columna 1"/>
            <Separator orientation="VERTICAL"/>
            <Label fx:id="lblLenguajeDetectado" text="Lenguaje: Desconocido"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEstadoModificado" text=""/>
        </HBox>
    </bottom>
</BorderPane>